# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: Execorn <execorn@users.noreply.github.com>
pkgname=wwal-git
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="High-performance Wayland wallpaper, video, shader, and Material You engine (C23)"
arch=('x86_64' 'aarch64')
url="https://github.com/Execorn/wwal"
license=('GPL-3.0-or-later')
depends=(
  'wayland'
  'libdrm'
  'mesa'
  'libva'
  'liburing'
  'libseccomp'
  'libpng'
  'libjpeg-turbo'
)
optdepends=(
  'libwebp: WebP static and animated image decoding'
  'libavif: AVIF and HEIC HDR/Solar dynamic wallpaper decoding'
  'libjxl: JPEG-XL next-generation image decoding'
  'librsvg: Native SVG vector wallpaper rasterization'
  'pipewire: Lock-free audio capture for 64-bin Bark FFT reactive shaders'
  'dbus: Zero-idle D-Bus MPRIS2 media metadata integration'
  'lz4: Fast native Wallpaper Engine .tex LZ4 decompression'
  'ffmpeg: Hardware-accelerated pre-transcoding for non-native animated formats'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'python'
  'scdoc'
  'wayland-protocols'
)
provides=('wwal' 'wwald')
conflicts=('wwal')

# Set WWAL_SWWW_COMPAT=1 in makepkg environment to install drop-in swww/awww symlinks.
_enable_swww_compat="${WWAL_SWWW_COMPAT:-0}"

pkgver() {
  cd "${startdir}/.."
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    echo "1.0.0.r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
  fi
}

build() {
  arch-meson "${startdir}/.." "${srcdir}/build" \
    -Doptimization=3 \
    -Db_lto=true \
    -Db_pie=true \
    -Denable_vaapi=true \
    -Denable_io_uring=true \
    -Denable_simd=true \
    -Denable_seccomp=true \
    -Denable_systemd=true
  meson compile -C "${srcdir}/build"
}

check() {
  meson test -C "${srcdir}/build" --print-errorlogs --suite waywal:core --suite waywal:advanced || \
    meson test -C "${srcdir}/build" --print-errorlogs
}

package() {
  DESTDIR="${pkgdir}" meson install -C "${srcdir}/build"
  install -Dm644 "${startdir}/../LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  if [[ "${_enable_swww_compat}" == "1" ]]; then
    provides+=('swww' 'awww')
    conflicts+=('swww' 'awww')
    ln -s wwal "${pkgdir}/usr/bin/swww"
    ln -s wwald "${pkgdir}/usr/bin/swww-daemon"
    ln -s wwal "${pkgdir}/usr/bin/awww"
    ln -s wwald "${pkgdir}/usr/bin/awww-daemon"
  fi
}
