#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
precision highp float;
precision highp int;
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;

const float PI = 3.14159265359;
const float HALF_PI = 1.57079632679;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 inv_res = 1.0 / vec2(u_resolution);
    vec2 uv = (vec2(coord) + 0.5) * inv_res;
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, vec4(texture(u_src_a, uv).rgb, 1.0).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, vec4(texture(u_src_b, uv).rgb, 1.0).bgra);
        return;
    }

    // Modeling a [-aspect, aspect] x [-1, 1] x [-aspect, aspect] prism with a square-pixel
    // pinhole camera at focal length d_cam * aspect cancels aspect out of X and Z identically.
    // Keep p_ndc in [-1, 1]^2 so both endpoints match the full-screen image on every aspect ratio.
    vec2 p_ndc = (uv - 0.5) * 2.0;

    float theta = u_progress * HALF_PI;
    float cos_t = cos(theta);
    float sin_t = sin(theta);

    // z_pull = (d_cam - 1.0) * 0.5 prevents both vertical hinge clipping and horizontal
    // outer-edge clipping across all progress values while returning to t = 1.0 at endpoints.
    const float d_cam = 2.5;
    const float z_pull = 0.75;
    float dist = (d_cam + 1.0) + z_pull * sin(u_progress * PI);

    vec3 rd = vec3(p_ndc, d_cam);
    vec3 ro_cube = vec3(dist * sin_t, 0.0, -dist * cos_t);
    vec3 rd_cube = vec3(rd.x * cos_t - rd.z * sin_t, rd.y, rd.x * sin_t + rd.z * cos_t);

    float t_front = -1.0;
    vec2 uv_front = vec2(0.0);
    if (ro_cube.z < -1.0 && rd_cube.z > 1e-6) {
        float t = (-1.0 - ro_cube.z) / rd_cube.z;
        if (t > 0.0) {
            vec2 hit_xy = ro_cube.xy + t * rd_cube.xy;
            if (hit_xy.x >= -1.0 && hit_xy.x <= 1.0 + 1e-5 && abs(hit_xy.y) <= 1.0) {
                t_front = t;
                uv_front = vec2(clamp(hit_xy.x * 0.5 + 0.5, 0.0, 1.0), hit_xy.y * 0.5 + 0.5);
            }
        }
    }

    float t_right = -1.0;
    vec2 uv_right = vec2(0.0);
    if (ro_cube.x > 1.0 && rd_cube.x < -1e-6) {
        float t = (1.0 - ro_cube.x) / rd_cube.x;
        if (t > 0.0) {
            vec2 hit_zy = vec2(ro_cube.z, ro_cube.y) + t * vec2(rd_cube.z, rd_cube.y);
            if (hit_zy.x >= -1.0 - 1e-5 && hit_zy.x <= 1.0 && abs(hit_zy.y) <= 1.0) {
                t_right = t;
                uv_right = vec2(clamp(hit_zy.x * 0.5 + 0.5, 0.0, 1.0), hit_zy.y * 0.5 + 0.5);
            }
        }
    }

    vec4 col = vec4(0.03, 0.03, 0.05, 1.0);
    if (t_front > 0.0 && (t_right < 0.0 || t_front <= t_right)) {
        float shade = 0.65 + 0.35 * cos_t;
        col = texture(u_src_a, uv_front) * vec4(vec3(shade), 1.0);
    } else if (t_right > 0.0) {
        float shade = 0.65 + 0.35 * sin_t;
        col = texture(u_src_b, uv_right) * vec4(vec3(shade), 1.0);
    }

    // Format alignment for DRM_FORMAT_ARGB8888 little-endian
    imageStore(u_target, coord, vec4(col.rgb, 1.0).bgra);
}
