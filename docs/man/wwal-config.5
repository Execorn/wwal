.\" Generated from wwal-config.5.scd
.TH "WWAL-CONFIG" "5" "2026-10-28" "wwal 1.1.0" "WayWal Manual"
.PP
.SH NAME
.PP
wwal-config - declarative TOML configuration file for wwald(1) and wwal(1)
.PP
.SH SYNOPSIS
.PP
\fB~/.config/wwal/config.toml\fR
.PP
.SH DESCRIPTION
.PP
\fBwwal\fR(1) and \fBwwald\fR(1) read their declarative configuration from \fB$WWAL_CONFIG_PATH\fR or \fB$XDG_CONFIG_HOME/wwal/config.toml\fR (defaulting to \fB~/.config/wwal/config.toml\fR). The file uses standard TOML syntax and is parsed by \fBwwald\fR's built-in zero-allocation parser at daemon startup and upon receiving \fBSIGHUP\fR. Leading \fB~/\fR and environment variables (\fB$HOME\fR, \fB$XDG_CONFIG_HOME\fR, \fB$XDG_CACHE_HOME\fR, \fB$XDG_DATA_HOME\fR, \fB$XDG_STATE_HOME\fR) are expanded automatically in all file path fields.
.PP
Command-line flags passed to \fBwwal\fR(1) override values configured in \fBconfig.toml\fR for that invocation.
.PP
.SH SECTIONS
.PP
.SS [daemon] (aliases: [general], [audio], [mpris])
.PP
Controls core \fBwwald\fR(1) lifecycle, layer-shell behavior, and Zero-Watt power governance.
.PP
\fBnamespace\fR = "<string>"
.RS 4
Default IPC and Wayland layer-shell namespace (default: \fB"default"\fR).
.RE
.PP
\fBlayer\fR = "<background|bottom>"
.RS 4
Wayland \fBzwlr_layer_shell_v1\fR layer used for wallpaper surfaces (default: \fB"background"\fR).
.RE
.PP
\fBbackdrop\fR = "<none|auto-blur|path>"
.RS 4
Secondary layer surface (\fBwaywal-backdrop\fR) mode for compositors with overview backdrops such as Niri (default: \fB"none"\fR). Set to \fB"auto-blur"\fR to run the GPU 2-pass Dual-Kawase blur shader automatically.
.RE
.PP
\fBcrop_gravity\fR = "<gravity>"
.RS 4
Default UV crop anchor for \fBfill\fR (\fBcrop\fR) scaling: \fBcenter\fR, \fBtop\fR, \fBbottom\fR, \fBleft\fR, \fBright\fR, \fBtop-left\fR (\fBtl\fR), \fBtop-right\fR (\fBtr\fR), \fBbottom-left\fR (\fBbl\fR), \fBbottom-right\fR (\fBbr\fR), cardinal aliases (\fBnorth\fR, \fBsouth\fR, \fBeast\fR, \fBwest\fR, \fBnw\fR, \fBne\fR, \fBsw\fR, \fBse\fR), or \fB"X,Y"\fR / \fB"X%,Y%"\fR (default: \fB"center"\fR).
.RE
.PP
\fBten_bit\fR, \fB10bit\fR = <bool>
.RS 4
Enable 10-bit wide-gamut scanout (\fBXRGB2101010\fR / \fBARGB2101010\fR) when supported by the compositor (default: \fBfalse\fR).
.RE
.PP
\fBrestore_on_start\fR = <bool>
.RS 4
Automatically restore per-output state from \fB$XDG_STATE_HOME/wwal/state.bin\fR when \fBwwald\fR starts or when a monitor is hotplugged (default: \fBtrue\fR).
.RE
.PP
\fBauto_pause_fullscreen\fR, \fBpause_on_fullscreen\fR = <bool>
.RS 4
Pause video and live shader rendering on an output when a fullscreen window covers it (default: \fBtrue\fR).
.RE
.PP
\fBauto_pause_maximized\fR, \fBpause_on_maximized\fR = <bool>
.RS 4
Pause video and live shader rendering on an output when a maximized window covers it (default: \fBfalse\fR).
.RE
.PP
\fBpause_on_occluded_workspace\fR = <bool>
.RS 4
Pause video and live shader rendering when Hyprland/Sway IPC reports the active workspace is fully tiled and opaque (default: \fBtrue\fR).
.RE
.PP
\fBpause_on_idle\fR = <bool>
.RS 4
Pause animations when \fBext_idle_notifier_v1\fR reports the user session is idle or locked (default: \fBtrue\fR).
.RE
.PP
\fBidle_timeout_sec\fR = <int>
.RS 4
Idle timeout in seconds before \fBext_idle_notifier_v1\fR pauses animations (default: \fB300\fR).
.RE
.PP
\fBbattery_policy\fR = "<ignore|reduce-fps|pause-video>"
.RS 4
Power governor behavior when running on laptop battery power (default: \fB"reduce-fps"\fR).
.RE
.PP
\fBworkshop_dir\fR = "<path>"
.RS 4
Custom Steam Workshop (\fB431960\fR) directory path override for \fBwwal workshop\fR.
.RE
.PP
\fBvolume\fR = <float>
.RS 4
Default wallpaper audio playback volume in \fB0.0..1.0\fR (default: \fB0.0\fR).
.RE
.PP
\fBmute_on_audio\fR = <bool>
.RS 4
Automatically duck wallpaper audio volume when another application plays audio via PipeWire (default: \fBfalse\fR).
.RE
.PP
\fBtheme_from_media\fR = <bool>
.RS 4
Dynamically extract Material Design 3 palettes from active D-Bus \fBMPRIS2\fR media player album art (default: \fBfalse\fR).
.RE
.PP
\fBrecursive\fR = <bool>
.RS 4
Scan slideshow directories recursively by default (default: \fBtrue\fR).
.RE
.PP
.SS [theme]
.PP
Controls the in-pipeline OKLab Wu quantizer + weighted K-Means++ + CAM16/HCT dual-mode Material Design 3 palette and template engine.
.PP
\fBenabled\fR, \fBenable\fR = <bool>
.RS 4
Automatically extract and export color palettes whenever a wallpaper changes (default: \fBtrue\fR).
.RE
.PP
\fBmode\fR = "<dark|light|auto>"
.RS 4
Target Material Design 3 tonal scheme polarity (default: \fB"dark"\fR).
.RE
.PP
\fBauto_day_night\fR = <bool>
.RS 4
Automatically switch between \fBdark\fR and \fBlight\fR theme polarity based on astronomical solar elevation (\fB[solar]\fR) or time of day (default: \fBfalse\fR).
.RE
.PP
\fBscheme_variant\fR = "<tonal_spot|vibrant|expressive|neutral|monochrome|fidelity|content|rainbow|fruit_salad>"
.RS 4
CAM16/HCT chroma and hue rotation variant (default: \fB"tonal_spot"\fR).
.RE
.PP
\fBcontrast\fR = <float>
.RS 4
Contrast level between \fB-1.0\fR and \fB1.0\fR (default: \fB0.0\fR).
.RE
.PP
\fBsource_color_index\fR = <0..3>
.RS 4
Select which of the 4 ranked K-Means++ seed clusters to use as the primary Material Design 3 seed (default: \fB0\fR).
.RE
.PP
\fBseed_color\fR = "<#RRGGBB>"
.RS 4
Optional static hex seed color override that bypasses image quantization when non-empty.
.RE
.PP
\fBcaelestia_sync\fR = <bool>
.RS 4
Atomically write \fB~/.local/state/caelestia/scheme.json\fR for Quickshell (\fBcaelestia-shell\fR) live theme synchronization (default: \fBtrue\fR).
.RE
.PP
\fBtty_sequences\fR, \fBterminal_osc\fR = <bool>
.RS 4
Broadcast non-blocking ANSI \fBOSC 4\fR, \fBOSC 10\fR, and \fBOSC 11\fR escape sequences to active \fB/dev/pts/*\fR terminals (default: \fBtrue\fR).
.RE
.PP
\fBexport_css\fR = <bool>
.RS 4
Write \fB~/.cache/wwal/colors.css\fR and \fB~/.cache/wwal/colors.json\fR (default: \fBtrue\fR).
.RE
.PP
\fBexport_hyprland\fR = <bool>
.RS 4
Write \fB~/.cache/wwal/colors-hyprland.conf\fR (default: \fBtrue\fR).
.RE
.PP
\fBpywal_compat\fR, \fBexport_pywal\fR = <bool>
.RS 4
Atomically write \fB~/.cache/wal/colors.json\fR, \fBcolors\fR, \fBcolors.sh\fR, \fBcolors.css\fR, and \fBsequences\fR for 100% \fBpywal\fR and \fBPywalfox\fR compatibility (default: \fBtrue\fR).
.RE
.PP
\fBtheme_from_media\fR = <bool>
.RS 4
Dynamically extract Material Design 3 palettes from active D-Bus \fBMPRIS2\fR media player album art (default: \fBfalse\fR).
.RE
.PP
.SS [template."<NAME>"] (alias: [templates."<NAME>"])
.PP
Defines a declarative configuration template rendered atomically whenever a theme is extracted. Both \fBdark\fR and \fBlight\fR palettes are synthesized simultaneously so templates can reference \fBdefault\fR, \fBdark\fR, and \fBlight\fR tokens in a single pass:
.PP
\fBinput_path\fR, \fBinput\fR, \fBtemplate\fR, \fBsrc\fR = "<path>"
.RS 4
Source template file path.
.RE
.PP
\fBoutput_path\fR, \fBoutput\fR, \fBtarget\fR, \fBdst\fR = "<path>"
.RS 4
Destination path where the rendered file is written atomically (protected against overwriting system directories or sensitive dotfiles such as \fB~/.ssh\fR).
.RE
.PP
\fBpost_hook\fR, \fBhook\fR = "<command>"
.RS 4
Optional shell command executed asynchronously after this template is rendered (for example, \fB"killall -SIGUSR1 kitty || true"\fR).
.RE
.PP
\fBenabled\fR, \fBenable\fR = <bool>
.RS 4
Enable or disable this template rule (default: \fBtrue\fR).
.RE
.PP
Supported template token syntax inside \fBinput_path\fR:
.IP \(bu 2
\fBMatugen dual-mode role & tonal tokens\fR: \fB{{colors.<role>.<default|dark|light>.<fmt>}}\fR and \fB{{palettes.<primary|secondary|tertiary|neutral|neutral_variant|error>.<0..100>.<fmt>}}\fR, where \fB<fmt>\fR is one of \fBhex\fR, \fBstrip\fR (\fBhex_stripped\fR), \fBrgb\fR, \fBrgb_css\fR, \fBrgba\fR, \fBxrgba\fR, \fBoctal\fR, \fBhsl\fR, \fBoklch\fR, \fBred\fR (\fBr\fR), \fBgreen\fR (\fBg\fR), \fBblue\fR (\fBb\fR), \fBalpha\fR (\fBa\fR), \fBhue\fR (\fBh\fR), \fBsaturation\fR (\fBs\fR), \fBlightness\fR (\fBl\fR).
.IP \(bu 2
\fBWallust / Jinja2 pipe filters\fR: \fBlighten(x)\fR, \fBdarken(x)\fR, \fBset_lightness(x)\fR (\fBlightness(x)\fR), \fBsaturate(x)\fR, \fBdesaturate(x)\fR, \fBalpha(x)\fR (\fBset_alpha(x)\fR), \fBblend(target, factor)\fR (in perceptual OKLab space), \fBinvert\fR, and \fBcomplementary\fR (180-degree OKLCh hue rotation). Supports chained pipes and parenthesized properties such as \fB{{ (colors.primary.default | lighten(0.15) | alpha(0.85)).rgba }}\fR.
.IP \(bu 2
\fBPywal single-brace tokens\fR: \fB{background}\fR, \fB{foreground}\fR, \fB{cursor}\fR, \fB{wallpaper}\fR, and \fB{color0}\fR..\fB{color15}\fR with optional \fB.strip\fR, \fB.rgb\fR, \fB.xrgba\fR, and \fB.octal\fR suffixes.
.PP
.SS [transition]
.PP
Sets default parameters for GPU compute and CPU SIMD wallpaper transitions.
.PP
\fBtype\fR = "<string>"
.RS 4
Default transition effect: \fBnone\fR, \fBsimple\fR, \fBfade\fR, \fBwipe\fR, \fBgrow\fR, \fBouter\fR, \fBwave\fR, \fBnoise\fR, \fBcrosszoom\fR, \fBslide\fR, \fBglitch\fR, \fBburn\fR, \fBripple\fR, \fBpixelate\fR, \fBdoom\fR, \fBswirl\fR, \fBcube\fR, \fBluma\fR, \fBlight_leak\fR, \fBpage_curl\fR, \fBcustom\fR, \fBleft\fR, \fBright\fR, \fBtop\fR, \fBbottom\fR, \fBcenter\fR, \fBany\fR, or \fBrandom\fR (default: \fB"fade"\fR).
.RE
.PP
\fBduration\fR = <float>
.RS 4
Transition duration in seconds as an unquoted floating-point number such as \fB0.75\fR or \fB1.2\fR (default: \fB1.2\fR).
.RE
.PP
\fBfps\fR = <int>
.RS 4
Target transition frame rate (default: \fB60\fR).
.RE
.PP
\fBangle\fR = <float>
.RS 4
Angle in degrees for directional transitions (default: \fB0.0\fR).
.RE
.PP
\fBpos\fR = "<string>"
.RS 4
Default anchor position, such as \fB"center"\fR, \fB"cursor"\fR, \fB"tl"\fR, or \fB"0.5,0.5"\fR (default: \fB"center"\fR).
.RE
.PP
\fBinvert_y\fR = <bool>
.RS 4
Invert the Y coordinate of \fBpos\fR (default: \fBfalse\fR).
.RE
.PP
\fBcrop_gravity\fR = "<gravity>"
.RS 4
Default crop anchor for transitions (default: \fB"center"\fR).
.RE
.PP
\fBbezier\fR = [ <x1>, <y1>, <x2>, <y2> ]
.RS 4
Four-element float array defining the cubic-bezier easing curve (default: \fB[ 0.25, 0.1, 0.25, 1.0 ]\fR).
.RE
.PP
\fBsync_mode\fR = "<simultaneous|staggered>"
.RS 4
Multi-monitor transition synchronization mode (default: \fB"simultaneous"\fR).
.RE
.PP
\fBstagger_delay_ms\fR = <int>
.RS 4
Delay in milliseconds between monitors in \fBstaggered\fR mode (default: \fB150\fR).
.RE
.PP
.SS [slideshow]
.PP
Sets global default parameters for mixed-media directory slideshows.
.PP
\fBinterval\fR, \fBduration\fR = <int|string>
.RS 4
Slideshow interval in seconds or human-readable units such as \fB"30m"\fR or \fB"1h"\fR (default: \fB300\fR).
.RE
.PP
\fBshuffle\fR = <bool>
.RS 4
Randomize slideshow order (default: \fBtrue\fR).
.RE
.PP
\fBsort\fR, \fBsorting\fR = "<ascending|descending|name|mtime|random>"
.RS 4
Default traversal order for slideshow directories (\fBname\fR is an alias for \fBascending\fR).
.RE
.PP
\fBrecursive\fR = <bool>
.RS 4
Scan slideshow directories recursively (default: \fBtrue\fR).
.RE
.PP
.SS [solar] & [[schedule]]
.PP
Configures astronomical solar elevation calculations (NOAA solar position equations) and time-of-day dynamic wallpaper and theme polarity switching.
.PP
\fBenabled\fR, \fBenable\fR = <bool>
.RS 4
Enable solar/schedule evaluation (default: \fBtrue\fR when solar paths or schedules are configured).
.RE
.PP
\fBlatitude\fR, \fBlat\fR = <float>
.RS 4
Geographic latitude in decimal degrees (\fB-90.0..90.0\fR).
.RE
.PP
\fBlongitude\fR, \fBlon\fR, \fBlng\fR = <float>
.RS 4
Geographic longitude in decimal degrees (\fB-180.0..180.0\fR).
.RE
.PP
\fBauto_theme_mode\fR, \fBauto_day_night\fR = <bool>
.RS 4
Automatically switch Material Design 3 theme polarity between \fBlight\fR (daytime) and \fBdark\fR (dusk/night) at solar transitions.
.RE
.PP
\fBsunrise\fR = "<HH:MM>", \fBsunset\fR = "<HH:MM>"
.RS 4
Explicit 24-hour sunrise and sunset time overrides when \fBlatitude\fR and \fBlongitude\fR are omitted.
.RE
.PP
\fBdawn_path\fR (\fBdawn\fR), \fBday_path\fR (\fBday\fR), \fBdusk_path\fR (\fBdusk\fR), \fBnight_path\fR (\fBnight\fR) = "<path>"
.RS 4
Shorthand wallpaper paths for the four solar periods.
.RE
.PP
\fBmanifest_path\fR, \fBmanifest\fR, \fBpath\fR = "<path>"
.RS 4
Optional GNOME \fB.xml\fR dynamic wallpaper manifest path.
.RE
.PP
Each \fB[[schedule]]\fR table supports:
.IP \(bu 2
\fBphase\fR = \fB"dawn|morning|day|noon|afternoon|dusk|evening|night"\fR or \fBtime\fR (\fBstart\fR) = \fB"HH:MM"\fR
.IP \(bu 2
\fBpath\fR (\fBimage\fR, \fBfile\fR, \fBmedia_path\fR) = \fB"<wallpaper-path>"\fR
.IP \(bu 2
\fBtheme_mode\fR (\fBmode\fR) = \fB"dark|light|auto"\fR
.IP \(bu 2
\fBoutput\fR (\fBoutput_name\fR) = \fB"<output-name>"\fR
.PP
.SS [hooks]
.PP
Configures optional shell commands executed asynchronously by \fBwwald\fR(1) on state changes.
.PP
\fBon_wallpaper_change\fR = "<command>"
.RS 4
Command executed after a wallpaper transition completes.
.RE
.PP
\fBon_theme_change\fR = "<command>"
.RS 4
Command executed after a Material Design 3 palette is exported.
.RE
.PP
.SS [output."<NAME>"], [default], [any]
.PP
Configures initial wallpaper, video, shader, Workshop scene, or slideshow settings for a specific Wayland output (such as \fB[output."DP-1"]\fR or \fB[output."eDP-1"]\fR). Use \fB[output."*"]\fR, \fB[default]\fR, or \fB[any]\fR (\fBwpaperd\fR compatibility) as a wildcard fallback for unconfigured monitors.
.PP
\fBpath\fR, \fBimage\fR, \fBmedia_path\fR = "<path>"
.RS 4
Path to an image, video, shader, Workshop scene, GNOME \fB.xml\fR schedule, or slideshow directory.
.RE
.PP
\fBmode\fR = "<img|video|shader|workshop|slideshow|color>"
.RS 4
Content mode for this output (default: inferred from \fIpath\fR).
.RE
.PP
\fBscaling\fR = "<fill|fit|fit-border-color|stretch|center|tile|span>"
.RS 4
Aspect-ratio scaling mode (default: \fB"fill"\fR).
.RE
.PP
\fBcrop_gravity\fR = "<gravity>"
.RS 4
Per-output UV crop anchor for \fBfill\fR (\fBcrop\fR) scaling.
.RE
.PP
\fBfilter\fR = "<Nearest|Bilinear|CatmullRom|Mitchell|Lanczos3>"
.RS 4
Per-output resampling filter hint.
.RE
.PP
\fBfill_color\fR, \fBcolor\fR = "<hex>"
.RS 4
Padding color for \fBfit\fR and \fBcenter\fR scaling modes, or solid color when \fBmode = "color"\fR (default: \fB"000000"\fR).
.RE
.PP
\fBinterval\fR, \fBduration\fR = <int|string>
.RS 4
Slideshow interval in seconds or human-readable duration string (\fB"30m"\fR, \fB"1h"\fR) when \fBmode = "slideshow"\fR (default: \fB300\fR).
.RE
.PP
\fBshuffle\fR = <bool>
.RS 4
Randomize slideshow order on this output (default: \fBtrue\fR).
.RE
.PP
\fBsort\fR, \fBsorting\fR, \fBorder\fR = "<ascending|descending|name|mtime|random>"
.RS 4
Per-output slideshow sort order.
.RE
.PP
\fBrecursive\fR = <bool>
.RS 4
Scan the output's slideshow directory recursively (default: \fBtrue\fR).
.RE
.PP
\fBaudio\fR = <bool>
.RS 4
Enable PipeWire Bark FFT audio capture when \fBmode = "shader"\fR or \fBmode = "workshop"\fR (default: \fBfalse\fR).
.RE
.PP
\fBvolume\fR = <float>
.RS 4
Per-output wallpaper audio playback volume in \fB0.0..1.0\fR (default: \fB0.0\fR).
.RE
.PP
\fBmute_on_audio\fR = <bool>
.RS 4
Per-output automatic volume ducking when external audio plays (default: \fBfalse\fR).
.RE
.PP
.SS [workspace."<NAME>"]
.PP
Binds a specific wallpaper, video, shader, Workshop scene, or slideshow to a named or numbered compositor workspace (such as \fB[workspace."1"]\fR or \fB[workspace."gaming"]\fR) on Hyprland, Sway, or Niri.
.PP
\fBpath\fR, \fBimage\fR, \fBmedia_path\fR = "<path>"
.RS 4
Wallpaper, video, shader, Workshop scene, or directory path to activate when switching to this workspace.
.RE
.PP
\fBoutput\fR, \fBoutput_name\fR = "<NAME>"
.RS 4
Optional output constraint if the workspace is pinned to a monitor.
.RE
.PP
\fBmode\fR = "<img|video|shader|workshop|slideshow|color>"
.RS 4
Content mode override for this workspace (default: inferred from \fIpath\fR).
.RE
.PP
\fBcolor\fR, \fBfill_color\fR = "<hex>"
.RS 4
Padding color or solid background color when \fBmode = "color"\fR.
.RE
.PP
\fBscaling\fR = "<fill|fit|fit-border-color|stretch|center|tile|span>"
.RS 4
Aspect-ratio scaling mode override for this workspace.
.RE
.PP
\fBcrop_gravity\fR = "<gravity>"
.RS 4
Per-workspace UV crop anchor for \fBfill\fR (\fBcrop\fR) scaling.
.RE
.PP
\fBfilter\fR = "<Nearest|Bilinear|CatmullRom|Mitchell|Lanczos3>"
.RS 4
Per-workspace resampling filter hint.
.RE
.PP
\fBinterval\fR, \fBduration\fR = <int|string>
.RS 4
Slideshow interval when \fBmode = "slideshow"\fR.
.RE
.PP
\fBshuffle\fR = <bool>
.RS 4
Randomize slideshow order on this workspace.
.RE
.PP
\fBsorting\fR, \fBsort\fR, \fBorder\fR = "<ascending|descending|name|mtime|random>"
.RS 4
Slideshow sort order on this workspace.
.RE
.PP
\fBrecursive\fR = <bool>
.RS 4
Scan the workspace's slideshow directory recursively.
.RE
.PP
\fBfps\fR = <int>
.RS 4
Target frame rate when running a shader or Workshop scene on this workspace.
.RE
.PP
\fBaudio\fR = <bool>
.RS 4
Enable PipeWire Bark FFT audio capture for this workspace's shader or Workshop scene.
.RE
.PP
\fBprop_overrides\fR, \fBprops\fR = "<key=val,...>"
.RS 4
Wallpaper Engine Workshop user property overrides for this workspace.
.RE
.PP
\fBtransition_type\fR, \fBtransition\fR = "<string>"
.RS 4
Optional transition effect override when entering this workspace.
.RE
.PP
\fBtransition_duration\fR = <float>
.RS 4
Optional transition duration in seconds when entering this workspace.
.RE
.PP
\fBtransition_angle\fR, \fBangle\fR = <float>
.RS 4
Optional transition angle in degrees when entering this workspace.
.RE
.PP
\fBdirectional\fR = <bool>
.RS 4
Automatically align slide/wipe transition direction with workspace switch direction (default: \fBtrue\fR).
.RE
.PP
.SH EXAMPLE
.PP
.nf
.RS 4
[daemon]
namespace = "default"
layer = "background"
backdrop = "auto-blur"
crop_gravity = "center"
10bit = true
restore_on_start = true
pause_on_fullscreen = true
pause_on_occluded_workspace = true
pause_on_idle = true
battery_policy = "pause-video"

[theme]
enable = true
mode = "dark"
auto_day_night = true
scheme_variant = "tonal_spot"
source_color_index = 0
caelestia_sync = true
terminal_osc = true
export_css = true
export_hyprland = true
pywal_compat = true

[template."kitty"]
input_path = "~/.config/wwal/templates/kitty.conf"
output_path = "~/.config/kitty/colors-wwal.conf"
post_hook = "killall -SIGUSR1 kitty || true"

[solar]
latitude = 37.7749
longitude = -122.4194
auto_theme_mode = true

[transition]
type = "grow"
duration = 0.75
fps = 144
pos = "cursor"
bezier = [ 0.22, 1.0, 0.36, 1.0 ]
sync_mode = "staggered"
stagger_delay_ms = 120

[default]
path = "~/Pictures/Wallpapers/Rotating"
duration = "30m"
sort = "mtime"
.RE
.fi
.PP
.SH SEE ALSO
.PP
\fBwwal\fR(1), \fBwwald\fR(1)
