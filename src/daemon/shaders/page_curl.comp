#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform float u_angle;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    float R = 0.12;
    // Peel line traverses from beyond 1.0 to below -R
    float line = 1.02 - u_progress * 1.25;

    // Curl axis along u_angle (defaults to 45-degree diagonal when 0)
    float angle = (abs(u_angle) > 1e-5) ? u_angle : 0.78539816;
    vec2 dir = vec2(cos(angle), -sin(angle));
    float span = max(abs(dir.x) + abs(dir.y), 1e-5);
    float s = dot(uv - vec2(0.5), dir) / span + 0.5;

    vec4 col;
    if (s < line) {
        // Unpeeled flat old wallpaper
        col = texture(u_src_a, uv);
    } else if (s < line + R) {
        // Active cylindrical curl region
        float dist = s - line;
        vec2 uv_curl = uv - (2.0 * span * dist) * dir;

        if (uv_curl.x >= 0.0 && uv_curl.x <= 1.0 && uv_curl.y >= 0.0 && uv_curl.y <= 1.0) {
            // Curled back of the peeling canvas with specular cylinder highlight
            float angle_norm = dist / R;
            float curl_light = 1.0 + 0.18 * sin(angle_norm * 3.14159265);
            vec4 old_col = texture(u_src_a, uv_curl);
            col = mix(old_col, old_col * curl_light, smoothstep(0.0, R * 0.25, dist));
            col.a = 1.0;
        } else {
            // Beneath curl: revealed new image with contact shadow
            float shadow = 0.5 + 0.5 * smoothstep(0.0, R * 1.8, dist);
            col = texture(u_src_b, uv) * vec4(vec3(shadow), 1.0);
        }
    } else if (s < line + R * 1.8) {
        // Revealed new wallpaper with soft contact drop shadow near curl edge
        float dist = s - line;
        float shadow = 0.5 + 0.5 * smoothstep(0.0, R * 1.8, dist);
        col = texture(u_src_b, uv) * vec4(vec3(shadow), 1.0);
    } else {
        col = texture(u_src_b, uv);
    }

    // Format alignment for DRM_FORMAT_ARGB8888 little-endian
    imageStore(u_target, coord, col.bgra);
}
