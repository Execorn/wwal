#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform float u_angle;
uniform float u_wave_amp; /* Motion blur intensity */

const float PI = 3.14159265359;

vec4 sample_directional_blur(highp sampler2D tex, vec2 base_uv, vec2 blur_offset, bool has_blur) {
    base_uv = clamp(base_uv, 0.0, 1.0);
    if (!has_blur) {
        return texture(tex, base_uv);
    }

    vec2 uv0 = clamp(base_uv - blur_offset, 0.0, 1.0);
    vec2 uv1 = clamp(base_uv + blur_offset, 0.0, 1.0);
    return (texture(tex, uv0) + texture(tex, uv1)) * 0.5;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    vec2 dir = vec2(cos(u_angle), sin(u_angle));

    float blur_strength = (u_wave_amp > 0.001) ? u_wave_amp : 0.08;
    float blur_mag = sin(u_progress * PI) * blur_strength;
    bool has_blur = (blur_mag >= 0.001);
    vec2 blur_offset = dir * (blur_mag * 0.25);

    /* A slides in +dir direction; B slides in from -dir direction */
    vec2 uv_a = uv - dir * u_progress;
    vec2 uv_b = uv + dir * (1.0 - u_progress);

    float span = max(abs(dir.x) + abs(dir.y), 1e-5);
    float proj = dot(uv - vec2(0.5), dir) / span + 0.5;
    float edge = 0.02 + blur_mag * 0.5;
    float p = u_progress * (1.0 + 2.0 * edge) - edge;
    float split = smoothstep(proj - edge, proj + edge, p);

    vec4 final_color;
    if (split <= 0.0) {
        final_color = sample_directional_blur(u_src_a, uv_a, blur_offset, has_blur);
    } else if (split >= 1.0) {
        final_color = sample_directional_blur(u_src_b, uv_b, blur_offset, has_blur);
    } else {
        vec4 color_a = sample_directional_blur(u_src_a, uv_a, blur_offset, has_blur);
        vec4 color_b = sample_directional_blur(u_src_b, uv_b, blur_offset, has_blur);
        final_color = mix(color_a, color_b, split);
    }

    imageStore(u_target, coord, final_color.bgra);
}
