#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform sampler2D u_src_a;
layout(binding = 2) uniform sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(u_resolution);
    vec2 p_ndc = (uv - 0.5) * 2.0;

    float theta = u_progress * 1.57079632679; // 0 to PI/2
    float zoom = 1.0 + 0.35 * sin(u_progress * 3.1415926535);

    // Camera setup: eye at (0, 0, -d_cam)
    float d_cam = 2.5;
    vec3 ro = vec3(0.0, 0.0, -d_cam);
    vec3 rd = normalize(vec3(p_ndc.x * zoom, p_ndc.y * zoom, d_cam));

    // Cube center at (0, 0, 1). Transform ray to cube local space rotated by -theta
    float cos_t = cos(theta);
    float sin_t = sin(theta);

    vec3 ro_rel = ro - vec3(0.0, 0.0, 1.0);
    vec3 ro_cube = vec3(ro_rel.x * cos_t - ro_rel.z * sin_t, ro_rel.y, ro_rel.x * sin_t + ro_rel.z * cos_t);
    vec3 rd_cube = vec3(rd.x * cos_t - rd.z * sin_t, rd.y, rd.x * sin_t + rd.z * cos_t);

    // Intersect Front face (old image): z_cube = -1.0
    float t_front = -1.0;
    if (abs(rd_cube.z) > 1e-5) {
        float t = (-1.0 - ro_cube.z) / rd_cube.z;
        if (t > 0.0) {
            vec3 hit = ro_cube + t * rd_cube;
            if (abs(hit.x) <= 1.0 && abs(hit.y) <= 1.0) {
                t_front = t;
            }
        }
    }

    // Intersect Right face (new image): x_cube = 1.0
    float t_right = -1.0;
    if (abs(rd_cube.x) > 1e-5) {
        float t = (1.0 - ro_cube.x) / rd_cube.x;
        if (t > 0.0) {
            vec3 hit = ro_cube + t * rd_cube;
            if (abs(hit.z) <= 1.0 && abs(hit.y) <= 1.0) {
                t_right = t;
            }
        }
    }

    vec4 col = vec4(0.03, 0.03, 0.05, 1.0); // Background void

    if (t_front > 0.0 && (t_right < 0.0 || t_front < t_right)) {
        vec3 hit = ro_cube + t_front * rd_cube;
        vec2 face_uv = vec2(hit.x * 0.5 + 0.5, hit.y * 0.5 + 0.5);
        float shade = 0.65 + 0.35 * cos_t;
        col = texture(u_src_a, face_uv) * vec4(vec3(shade), 1.0);
    } else if (t_right > 0.0) {
        vec3 hit = ro_cube + t_right * rd_cube;
        // x_cube = 1.0, z goes from -1 (front) to 1 (back). Map to [0, 1]
        vec2 face_uv = vec2((hit.z + 1.0) * 0.5, hit.y * 0.5 + 0.5);
        float shade = 0.65 + 0.35 * sin_t;
        col = texture(u_src_b, face_uv) * vec4(vec3(shade), 1.0);
    }

    // Format alignment for DRM_FORMAT_ARGB8888 little-endian
    imageStore(u_target, coord, col.bgra);
}
