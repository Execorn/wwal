#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform vec2  u_center;
uniform float u_wave_freq; /* Ripple frequency */
uniform float u_wave_amp;  /* Refraction amplitude */

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    vec2 center = (u_center.x > 0.0 || u_center.y > 0.0) ? u_center : vec2(0.5);

    float aspect = float(u_resolution.x) / float(u_resolution.y);
    vec2 raw_delta = uv - center;
    vec2 delta = vec2(raw_delta.x * aspect, raw_delta.y);
    float dist2 = dot(delta, delta);

    const float wave_width = 0.18;
    float max_dist = length(max(center, vec2(1.0) - center) * vec2(aspect, 1.0));
    float current_radius = mix(-0.03, max_dist + wave_width, u_progress);
    float r_in = current_radius - wave_width;
    float r_out = current_radius + wave_width;

    if (r_in > 0.0 && dist2 <= r_in * r_in) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }
    if (dist2 >= r_out * r_out) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }

    float dist = sqrt(dist2);
    float freq = (u_wave_freq > 0.0) ? u_wave_freq : 32.0;
    float amp = (u_wave_amp > 0.0) ? u_wave_amp : 0.04;

    float diff = dist - current_radius;
    float env = smoothstep(0.0, 0.08, u_progress) * (1.0 - u_progress) * (1.0 - u_progress);
    float decay = env;

    vec2 norm_dir = (dist > 0.0001) ? (raw_delta / dist) : vec2(0.0);

    float window = 1.0 - smoothstep(0.0, wave_width, abs(diff));
    float wave = sin(diff * freq) * amp * decay * window;
    float crest = max(0.0, -wave / amp) * decay * 0.22;

    vec2 refracted_uv = clamp(uv + norm_dir * wave, 0.0, 1.0);

    /* Reveal incoming image inside the expanding shockwave */
    float split = smoothstep(current_radius - 0.02, current_radius + 0.02, dist);
    vec4 result;
    if (split <= 0.0) {
        result = texture(u_src_b, refracted_uv);
    } else if (split >= 1.0) {
        result = texture(u_src_a, refracted_uv);
    } else {
        vec4 color_a = texture(u_src_a, refracted_uv);
        vec4 color_b = texture(u_src_b, refracted_uv);
        result = mix(color_b, color_a, split);
    }

    /* Specular water shimmer on wave crest */
    result.rgb += vec3(crest);

    imageStore(u_target, coord, clamp(result, 0.0, 1.0).bgra);
}
