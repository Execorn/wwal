#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		-Denable_vaapi=true \
		-Denable_io_uring=true \
		-Denable_simd=true \
		-Denable_seccomp=true \
		-Denable_systemd=true

override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 contrib/systemd/wwald.socket debian/wwal/usr/lib/systemd/user/wwald.socket
	install -D -m 0644 docs/man/wwal.1 debian/wwal/usr/share/man/man1/wwal.1
	install -D -m 0644 docs/man/wwald.1 debian/wwal/usr/share/man/man1/wwald.1
	install -D -m 0644 docs/man/wwal-config.5 debian/wwal/usr/share/man/man5/wwal-config.5

override_dh_auto_test:
	meson test -C obj-$(DEB_HOST_GNU_TYPE) phase1
