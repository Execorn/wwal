#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform vec2 u_center;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    vec2 center = (u_center.x > 0.0 || u_center.y > 0.0) ? u_center : vec2(0.5);
    float aspect = float(u_resolution.x) / float(u_resolution.y);
    vec2 delta = uv - center;
    delta.x *= aspect;

    float dist2 = dot(delta, delta);
    float max_dist = length(vec2(max(center.x, 1.0 - center.x) * aspect,
                                 max(center.y, 1.0 - center.y))) + 0.05;
    float edge = 0.03 * max_dist;
    float r = (1.0 - u_progress) * (max_dist + 2.0 * edge) - edge;
    float r_inner = r - edge;
    float r_outer = r + edge;

    vec4 col;
    if (r_inner > 0.0 && dist2 <= r_inner * r_inner) {
        col = texture(u_src_a, uv);
    } else if (r_outer <= 0.0 || dist2 >= r_outer * r_outer) {
        col = texture(u_src_b, uv);
    } else {
        float dist = sqrt(dist2);
        float alpha = smoothstep(r_inner, r_outer, dist);
        col = mix(texture(u_src_a, uv), texture(u_src_b, uv), alpha);
    }
    imageStore(u_target, coord, col.bgra);
}
