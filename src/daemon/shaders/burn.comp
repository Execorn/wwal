#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform float u_wave_freq; /* Noise frequency scale */
uniform float u_wave_amp;  /* Flame width */

float hash21(vec2 p) {
    uvec2 q = uvec2(ivec2(p)) * uvec2(1597334677u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334677u;
    return float(n) * (1.0 / 4294967296.0);
}

float value_noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    return 0.65 * value_noise(p) + 0.35 * value_noise(p * 2.1 + vec2(1.7, 3.2));
}

vec3 fire_color(float t) {
    /* Glowing blackbody fire gradient: Ash -> Crimson -> Orange -> White Hot */
    const vec3 ash = vec3(0.08, 0.03, 0.02);
    const vec3 red = vec3(0.85, 0.10, 0.02);
    const vec3 orange = vec3(1.00, 0.55, 0.08);
    const vec3 yellow_white = vec3(1.00, 0.95, 0.70);

    float s0 = clamp(t * 4.0, 0.0, 1.0);
    float s1 = clamp((t - 0.25) * 2.5, 0.0, 1.0);
    float s2 = clamp((t - 0.65) * 2.857142857, 0.0, 1.0);

    vec3 c = mix(ash, red, s0);
    c = mix(c, orange, s1);
    c = mix(c, yellow_white, s2);
    return c;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    float scale = (u_wave_freq > 0.0) ? u_wave_freq : 14.0;
    float flame_width = (u_wave_amp > 0.0) ? u_wave_amp : 0.08;

    float n = fbm(uv * scale);

    float p = u_progress * (1.0 + 2.0 * flame_width) - flame_width;
    float d = n - p;

    if (d >= flame_width) {
        /* Unburned area: sample only outgoing image A */
        vec4 color_a = texture(u_src_a, uv);
        imageStore(u_target, coord, color_a.bgra);
    } else if (d <= -flame_width) {
        /* Fully burned area: sample only incoming image B */
        vec4 color_b = texture(u_src_b, uv);
        imageStore(u_target, coord, color_b.bgra);
    } else {
        /* Active combustion wavefront */
        vec4 color_a = texture(u_src_a, uv);
        vec4 color_b = texture(u_src_b, uv);

        float burn_factor = smoothstep(flame_width, -flame_width, d);
        vec4 base = mix(color_a, color_b, burn_factor);

        /* Ember heat intensity peaking near the center of the combustion band */
        float dist_norm = 1.0 - abs(d) / flame_width;
        float heat = dist_norm * sqrt(dist_norm);
        vec3 flame = fire_color(heat) * (heat * 1.8);

        vec3 charred = base.rgb * (1.0 - heat * 0.5);
        vec3 result = charred + flame;

        imageStore(u_target, coord, vec4(clamp(result, 0.0, 1.0), 1.0).bgra);
    }
}
