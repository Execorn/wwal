#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
precision highp float;
precision highp int;
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform vec2 u_center;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 inv_res = 1.0 / vec2(u_resolution);
    vec2 uv = (vec2(coord) + 0.5) * inv_res;
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, vec4(texture(u_src_a, uv).rgb, 1.0).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, vec4(texture(u_src_b, uv).rgb, 1.0).bgra);
        return;
    }

    vec2 center = (u_center.x > 0.0 || u_center.y > 0.0) ? u_center : vec2(0.5, 0.5);

    float aspect = float(u_resolution.x) * inv_res.y;
    float inv_aspect = float(u_resolution.y) * inv_res.x;
    vec2 d = uv - center;
    d.x *= aspect;

    float r2 = dot(d, d);
    const float max_r = 0.85;
    const float inv_max_r = 1.0 / 0.85;
    const float max_r2 = 0.7225;

    vec2 uv_distorted = uv;
    if (r2 < max_r2) {
        float r = sqrt(r2);
        // Swirl angle peaks at progress midpoint
        float angle_amt = sin(u_progress * 3.1415926535) * 8.0;
        float factor = (1.0 - r * inv_max_r);
        float theta = factor * factor * angle_amt;
        float cos_t = cos(theta);
        float sin_t = sin(theta);
        vec2 rotated = vec2(d.x * cos_t - d.y * sin_t, d.x * sin_t + d.y * cos_t);
        rotated.x *= inv_aspect;
        uv_distorted = center + rotated;
    }

    vec4 c1 = texture(u_src_a, uv_distorted);
    vec4 c2 = texture(u_src_b, uv_distorted);

    vec4 col = mix(c1, c2, u_progress);

    // Format alignment for DRM_FORMAT_ARGB8888 little-endian
    imageStore(u_target, coord, vec4(col.rgb, 1.0).bgra);
}
