#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    // Smoothstep cross dissolve centered around midpoint
    float mix_factor = smoothstep(0.25, 0.75, u_progress);
    vec4 col;
    if (mix_factor <= 0.0) {
        col = texture(u_src_a, uv);
    } else if (mix_factor >= 1.0) {
        col = texture(u_src_b, uv);
    } else {
        col = mix(texture(u_src_a, uv), texture(u_src_b, uv), mix_factor);
    }

    // Anamorphic flare beam sweeps diagonally across frame
    float sweep = u_progress * 1.6 - 0.3;
    float d_beam = uv.x + uv.y * 0.25 - sweep;
    float t_beam = max(0.0, 1.0 - (d_beam * d_beam) * 10.666667);
    float flare_beam = t_beam * t_beam * t_beam;

    // Optical flare secondary orbs
    vec2 d1 = uv - vec2(sweep + 0.1, 0.4);
    float t1 = max(0.0, 1.0 - dot(d1, d1) * 4.0);
    float orb1 = t1 * t1 * t1;

    vec2 d2 = uv - vec2(sweep - 0.2, 0.7);
    float t2 = max(0.0, 1.0 - dot(d2, d2) * 7.0);
    float orb2 = t2 * t2 * t2;

    // Smooth envelope: 0 at start and end
    float envelope = sin(u_progress * 3.1415926535);
    envelope = envelope * envelope;

    vec3 warm_flare = vec3(1.1, 0.65, 0.25) * flare_beam * 1.8;
    warm_flare += vec3(1.0, 0.85, 0.4) * orb1 * 1.2;
    warm_flare += vec3(0.9, 0.3, 0.5) * orb2 * 1.0;

    col.rgb = clamp(col.rgb + warm_flare * envelope, 0.0, 1.0);

    // Format alignment for DRM_FORMAT_ARGB8888 little-endian
    imageStore(u_target, coord, col.bgra);
}
