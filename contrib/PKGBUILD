# Maintainer: Execorn <execorn@users.noreply.github.com>
pkgname=wwal-git
pkgver=1.0.0.r8.gfc7ae4a
pkgrel=1
pkgdesc="Modern high-performance Wayland wallpaper daemon and client (C23)"
arch=('x86_64' 'aarch64')
url="https://github.com/Execorn/wwal"
license=('GPL3')
depends=(
  'wayland'
  'libdrm'
  'mesa'
  'libva'
  'liburing'
  'libseccomp'
  'libpng'
  'libjpeg-turbo'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'wayland-protocols'
)
provides=('wwal' 'wwald')
conflicts=('wwal')

pkgver() {
  cd "${startdir}/.."
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    echo "1.0.0.r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
  fi
}

build() {
  arch-meson "${startdir}/.." "${srcdir}/build" \
    -Doptimization=3 \
    -Db_lto=true \
    -Db_pie=true \
    -Denable_systemd=true
  ninja -C "${srcdir}/build"
}

package() {
  DESTDIR="${pkgdir}" ninja -C "${srcdir}/build" install
}
