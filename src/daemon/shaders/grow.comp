#version 310 es
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform vec2 u_center;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    float aspect = float(u_resolution.x) / float(u_resolution.y);
    vec2 delta = uv - u_center;
    delta.x *= aspect;

    float dist = length(delta);
    float max_dist = length(vec2(max(u_center.x, 1.0 - u_center.x) * aspect,
                                 max(u_center.y, 1.0 - u_center.y))) + 0.05;
    float edge = 0.03 * max_dist;
    float r = u_progress * (max_dist + 2.0 * edge) - edge;
    float alpha = smoothstep(dist - edge, dist + edge, r);

    vec4 col;
    if (alpha <= 0.0) {
        col = texture(u_src_a, uv);
    } else if (alpha >= 1.0) {
        col = texture(u_src_b, uv);
    } else {
        col = mix(texture(u_src_a, uv), texture(u_src_b, uv), alpha);
    }
    imageStore(u_target, coord, col.bgra);
}
