# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: Execorn <execorn@users.noreply.github.com>
pkgname=wwal
pkgver=1.0.0
pkgrel=0
pkgdesc="Zero-copy C23 Wayland wallpaper, VA-API video, Shadertoy, and Material You engine"
url="https://github.com/Execorn/wwal"
arch="x86_64 aarch64"
license="GPL-3.0-or-later"
makedepends="
	meson
	ninja
	pkgconf
	python3
	scdoc
	wayland-dev
	wayland-protocols
	libdrm-dev
	mesa-dev
	libva-dev
	liburing-dev
	libseccomp-dev
	libpng-dev
	libjpeg-turbo-dev
	linux-headers
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/Execorn/wwal/archive/v$pkgver.tar.gz"

build() {
	abuild-meson \
		-Db_lto=true \
		-Denable_vaapi=true \
		-Denable_io_uring=true \
		-Denable_simd=true \
		-Denable_seccomp=true \
		-Denable_systemd=false \
		. output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output core
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}
