#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;
uniform float u_angle;
uniform float u_wave_freq;
uniform float u_wave_amp;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    vec2 dir = vec2(cos(u_angle), sin(u_angle));
    vec2 centered = uv - vec2(0.5);
    float proj = dot(centered, dir) / max(abs(dir.x) + abs(dir.y), 1e-5) + 0.5;

    float freq = (u_wave_freq > 0.0) ? u_wave_freq : 20.0;
    float amp = (u_wave_amp > 0.0) ? u_wave_amp : 0.05;
    float edge = 0.04;
    float margin = amp + edge;
    float p = u_progress * (1.0 + 2.0 * margin) - margin;

    if (proj - p >= margin) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (p - proj >= margin) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    vec2 perp = vec2(-dir.y, dir.x);
    float cross_proj = dot(centered, perp);
    float wave = sin(cross_proj * freq) * amp;
    float d = proj + wave;
    float alpha = smoothstep(d - edge, d + edge, p);

    vec4 col;
    if (alpha <= 0.0) {
        col = texture(u_src_a, uv);
    } else if (alpha >= 1.0) {
        col = texture(u_src_b, uv);
    } else {
        col = mix(texture(u_src_a, uv), texture(u_src_b, uv), alpha);
    }
    imageStore(u_target, coord, col.bgra);
}
