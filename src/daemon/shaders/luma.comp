#version 310 es
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;

/* Stateless 2D integer hash (JCGT / Inigo Quilez) */
vec2 hash2(vec2 p) {
    uvec2 q = uvec2(ivec2(p)) * uvec2(1597334677u, 3812015801u);
    q = (q.x ^ q.y) * uvec2(1597334677u, 3812015801u);
    return -1.0 + 2.0 * (vec2(q) * (1.0 / 4294967296.0));
}

float noise2(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(dot(hash2(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0)),
                   dot(hash2(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0)), u.x),
               mix(dot(hash2(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0)),
                   dot(hash2(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0)), u.x), u.y);
}

float fbm(vec2 p) {
    mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
    float v = 0.70 * noise2(p) + 0.30 * noise2(rot * p * 2.0 + vec2(100.0));
    return v * 0.5 + 0.5;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    float aspect = float(u_resolution.x) / float(u_resolution.y);

    /* Multi-octave organic luma pattern (3 octaves) */
    float n = fbm(vec2(uv.x * aspect, uv.y) * 4.0);

    /* Threshold spans from -0.1 to 1.1 across progress */
    float threshold = u_progress * 1.2 - 0.1;
    float softness = 0.08;

    float alpha = smoothstep(threshold - softness, threshold + softness, n);
    float mix_val = 1.0 - alpha;

    /* Organic ink bleed edge highlight */
    bool has_glow = false;
    float glow = 0.0;
    if (u_progress > 0.05 && u_progress < 0.95) {
        float edge = 1.0 - abs(n - threshold) / (softness * 2.0);
        if (edge > 0.0) {
            has_glow = true;
            glow = edge * edge * sin(u_progress * 3.1415926535) * 0.25;
        }
    }

    vec4 col;
    if (mix_val <= 0.0 && !has_glow) {
        col = texture(u_src_a, uv);
    } else if (mix_val >= 1.0 && !has_glow) {
        col = texture(u_src_b, uv);
    } else {
        vec4 c_old = texture(u_src_a, uv);
        vec4 c_new = texture(u_src_b, uv);
        col = mix(c_old, c_new, mix_val);
        if (has_glow) {
            col.rgb += vec3(glow * 0.3, glow * 0.6, glow * 1.0);
        }
    }

    imageStore(u_target, coord, col.bgra);
}
