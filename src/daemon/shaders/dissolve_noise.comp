#version 310 es
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8, binding = 0) writeonly uniform highp image2D u_target;
layout(binding = 1) uniform highp sampler2D u_src_a;
layout(binding = 2) uniform highp sampler2D u_src_b;

uniform float u_progress;
uniform ivec2 u_resolution;

/* High-efficiency procedural noise generator */
float hash21(vec2 p) {
    uvec2 q = uvec2(ivec2(p)) * uvec2(1597334677u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334677u;
    return float(n) * (1.0 / 4294967296.0);
}

float noise(vec2 uv) {
    vec2 i = floor(uv);
    vec2 f = fract(uv);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_resolution.x || coord.y >= u_resolution.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_resolution);
    if (u_progress <= 0.0) {
        imageStore(u_target, coord, texture(u_src_a, uv).bgra);
        return;
    }
    if (u_progress >= 1.0) {
        imageStore(u_target, coord, texture(u_src_b, uv).bgra);
        return;
    }

    float n = noise(uv * 16.0);

    float edge = 0.05;
    float p = u_progress * (1.0 + 2.0 * edge) - edge;
    float alpha = smoothstep(n - edge, n + edge, p);

    vec4 col;
    if (alpha <= 0.0) {
        col = texture(u_src_a, uv);
    } else if (alpha >= 1.0) {
        col = texture(u_src_b, uv);
    } else {
        col = mix(texture(u_src_a, uv), texture(u_src_b, uv), alpha);
    }
    imageStore(u_target, coord, col.bgra);
}
